# ==============================================================================
# Atlas Web Environment Configuration
# ==============================================================================

# 1. MongoDB Database
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/atlas?retryWrites=true&w=majority"

# 2. JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# 3. Vapi Voice AI Platform Keys
# Client-side public key for browser WebRTC connection (found in Vapi Dashboard -> Account -> API Keys)
NEXT_PUBLIC_VAPI_PUBLIC_KEY="your-vapi-public-key"

# Server-side private key for creating & updating mentor assistants via REST API
VAPI_API_KEY="your-vapi-private-key"

# 4. (Optional) Stripe Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
